# TradePulse Pro — Environment Configuration Template
# Copy this file to .env for local overrides. Do NOT commit real secret keys.

# Client-Side Settings (Vite exposes VITE_ prefixed variables to the browser)
VITE_APP_NAME="TradePulse Pro"
VITE_APP_ENV="development"
VITE_DATA_MODE="simulated" # Options: simulated | real (Phase 3+)
VITE_API_BASE_URL="http://localhost:5000/api/v1"

# Backend & Server Settings (For Phase 5+; NEVER expose to client)
PORT=5000
NODE_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tradepulse_db?schema=public"
JWT_SECRET="replace-with-a-secure-random-secret-in-production"

# External Market Data Providers (Server-side only)
FINNHUB_API_KEY="your_finnhub_api_key_here"
ALPHA_VANTAGE_API_KEY="your_alpha_vantage_api_key_here"
