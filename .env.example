# TradePulse Pro — Environment Configuration Template
# Copy this file to .env for local overrides. Do NOT commit real secret keys.

# Backend & Server Settings
PORT=5000
NODE_ENV=development

# External Market Data Providers (Server-side only)
# Obtain your free API key at https://finnhub.io/
FINNHUB_API_KEY=

# Neon Postgres Database (Server-side only — keep secret, do not expose to client)
# Runtime pooled connection for application queries
DATABASE_URL=postgresql://<user>:<password>@<dev-endpoint-pooler>.neon.tech/<dbname>?sslmode=require&channel_binding=require

# Direct connection for schema migrations
DIRECT_URL=postgresql://<user>:<password>@<dev-endpoint-direct>.neon.tech/<dbname>?sslmode=require&channel_binding=require

# Express Session Secret
SESSION_SECRET=your_dev_session_secret_min_32_characters
