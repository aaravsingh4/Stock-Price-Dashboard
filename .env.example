# TradePulse Pro — Environment Configuration Template
# Copy this file to .env for local overrides. Do NOT commit real secret keys.

# Backend & Server Settings
PORT=5000
NODE_ENV=development

# External Market Data Providers (Server-side only)
# Obtain your free API key at https://finnhub.io/
FINNHUB_API_KEY=

# Neon Postgres Database (Server-side only — keep secret, do not expose to client)
# Form: postgresql://<user>:<password>@<endpoint-pooler>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=
